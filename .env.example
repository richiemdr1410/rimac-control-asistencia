# Copiar a .env y completar localmente; no contiene credenciales reales.
PERSISTENCE_ADAPTER=POSTGRESQL
DEFAULT_TIMEZONE=America/Costa_Rica
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=60
NODE_ENV=development
# El servidor actual escucha en 3000 de forma fija.
PORT=3000
APP_URL=http://localhost:3000
# Conexión ficticia. Sustituir usuario y contraseña.
DATABASE_URL=postgresql://USUARIO_DEMO:CAMBIAR_PASSWORD@localhost:5432/asistencia_demo
# Alternativa AI Studio: comentar DATABASE_URL y completar estas variables.
# SQL_HOST=
# SQL_USER=
# SQL_PASSWORD=
# SQL_DB_NAME=
# Cuenta alternativa para migraciones y seed, si corresponde:
# SQL_ADMIN_USER=
# SQL_ADMIN_PASSWORD=
GEMINI_API_KEY=
# Opcional; por defecto se utiliza storage/rag_docs.
# RAG_STORAGE_PATH=
