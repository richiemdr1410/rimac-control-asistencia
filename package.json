{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "seed": "tsx src/server/seed-cli.ts",
    "test": "tsx --test src/server/health.test.ts && tsx src/server/tests/prueba-externa-firestore-deny-all.test.ts && tsx src/server/tests/fase-2e-regression.test.ts && tsx src/server/tests/fase-3-e2e.test.ts && tsx src/server/tests/fase-3-1-segregacion-autoaprobacion.test.ts && tsx src/server/tests/fase-3-2b-rbac-dinamico.test.ts && tsx src/server/tests/fase-4a-incidencias-correcciones.test.ts && tsx src/server/tests/fase-4a-1-correcciones-ui-errores.test.ts && tsx src/server/tests/fase-4a-2-autoaprobacion-solicitudes.test.ts && tsx src/server/tests/fase-4b-consolidacion-jornadas-pausas-tiempo-adicional.test.ts",
    "test:fase4a": "tsx src/server/tests/fase-4a-incidencias-correcciones.test.ts",
    "test:fase4a1": "tsx src/server/tests/fase-4a-1-correcciones-ui-errores.test.ts",
    "test:fase4a2": "tsx src/server/tests/fase-4a-2-autoaprobacion-solicitudes.test.ts",
    "test:fase4b": "tsx src/server/tests/fase-4b-consolidacion-jornadas-pausas-tiempo-adicional.test.ts",
    "test:fase4b1": "tsx src/server/tests/fase-4b-1-correccion-jornadas-rbac-calculos.test.ts",
    "test:all": "npm test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
